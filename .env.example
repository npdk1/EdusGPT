# =============================================================================
# EdusGPT — environment variables
# Copy to .env, or simply open http://localhost:3000/setup and paste the
# key there (the setup page writes .env for you and reloads the server).
# =============================================================================

# --- Provider -------------------------------------------------------------
# Which backend the app talks to:
#   gemini | openrouter | groq | nvidia | mistral | antigravity
AI_PROVIDER=gemini

# --- Google Gemini (free tier is 20 requests/day) ---------------------------
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- OpenRouter (fallback when the Gemini quota is spent) ------------------
# Get a key at https://openrouter.ai/keys
# Models ending in ":free" cost nothing, e.g. google/gemini-2.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Groq, NVIDIA, Mistral (OpenAI-compatible, đều có gói free) -------------
# Cùng một adapter, chỉ khác base URL. Chọn cái nào còn quota khi cái kia hết.
# Groq: nhanh nhất, free 30 req/phút và 200k token/ngày cho mỗi model.
#       Bài dài 95 slide (~96 lượt) vượt hạn mức này — dùng cho bài ngắn.
#       Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# NVIDIA: endpoint free để thử nghiệm, Get a key at https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Mistral: credits theo project ở chế độ Free.
#          Get a key at https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# --- Antigravity CLI (agent chạy ngầm trên máy, không cần API key) ---------
# Cài:      powershell -ExecutionPolicy Bypass -File scripts/install-antigravity.ps1
# Đăng nhập: chạy `agy` một lần trong terminal (interactive, xong thì đóng).
# Cấp quyền cho agent đọc tài liệu: node scripts/antigravity-permissions.mjs
# Chọn provider ở /setup cũng được, không cần dán key.
# Đổi tên/đường dẫn binary nếu không phải tên "agy": AGY_BINARY=/duong/dan/agy
# AGY_BINARY=agy
# auto = để agent tự chọn theo từng câu. Xem `agy models` để biết model hiện có.
# auto | gemini-3.8-flash-high | gemini-3.1-pro-high | claude-sonnet-4-6 | ...
ANTIGRAVITY_MODEL=auto
# Thư viện tài liệu agent được phép đọc. Mặc định ONLY_FOR_AI_TO_LEARN.
# Đổi sang thư mục khác thì chạy lại: node scripts/index-course-library.mjs --dir <thư mục>
# COURSE_LIBRARY_DIR=D:/Tai lieu Hoc
# Quyền tool của agent. Headless (`agy -p`) không hỏi được nên tool bị chặn sẽ
# hỏng cả lượt trả lời. Trên Windows 1.2.14 app tự bật --dangerously-skip-permissions
# vì allow-rule không có tác dụng ở đó; hai biến dưới ghi đè hành vi đó.
# ANTIGRAVITY_STRICT_PERMISSIONS=1   # không bao giờ tự duyệt tool (agent có thể bị chặn)
# ANTIGRAVITY_SKIP_PERMISSIONS=1     # ép tự duyệt ở mọi OS
# ANTIGRAVITY_DEBUG_LOG=agy-debug.log # xem chính xác agent làm gì mỗi lượt

# --- App --------------------------------------------------------------------
# Only requests coming from these hosts may read/write the key through /setup.
# Comma separated. Defaults to localhost/127.0.0.1/[::1] when unset.
# LOCAL_ONLY_HOSTS=localhost,127.0.0.1

# --- Security -------------------------------------------------------------
# Extra hosts allowed in *_BASE_URL, on top of the vendor defaults. Only needed
# for a self-hosted gateway or a corporate proxy; every request to this host
# carries your API key, so treat it as trusted.
# AI_ALLOWED_BASE_HOSTS=
# DANGER: turns off the local-only check on /setup and /api/courses. Only set
# this on a machine you are certain is not reachable from the network.
# ALLOW_REMOTE_KEY_ADMIN=false
