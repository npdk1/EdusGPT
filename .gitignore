# dependencies
node_modules
.pnpm-store

# next
.next
out
build
next-env.d.ts

# Secrets never ship. `.env` is where /setup writes your API key, and
# `.env.example` carries the documented defaults for a fresh clone — copy it
# with `run.bat` (or by hand) and the app starts with zero setup.
.env
.env.local

# Generated lesson library index + cached narration rebuild themselves.
data/library-text/
data/tts-cache/

# Giọng nói tải về cho giọng đọc chạy trên máy (Piper). Mỗi voice là một file
# .onnx 60 MB, tải lại được bằng nút "cài giọng" ở /setup, nên để trong repo chỉ
# làm nặng lịch sử git.
/data/voices/

# Han muc token do provider do day ra, tu hoc lai. May, khong phai
# cau hinh cua bai.
/data/token-limits.json

# Nhung run.bat tai ve: Node.js portable, ffmpeg, Python, venv + piper.
# Chi la thu muc may, khong phai san pham.
/.runtime/

# misc
.DS_Store
*.log
.vercel
tsconfig.tsbuildinfo

# scratch captures from the browser tooling (never source)
.playwright-mcp

# scratch files produced by the scripts in scripts/
/*.txt
/h.json
/gen.log
/gen.err
/generated-lesson.json
/exported.html
/exported-player.js
/*.png

# Saved lessons ship with the tool (data/courses/).

# Tài liệu gốc của người học. Giữ ngoài repo: đây là slide PDF của trường, nặng
# hàng trăm MB, và phần GDQP là giấy tờ hành chính — không nên nằm trong lịch sử
# git. Thư viện vẫn dùng được nhờ `data/course-library.json` (chỉ là manifest,
# không chứa nội dung) và `npm run index:library` để dựng lại.
/ONLY_FOR_AI_TO_LEARN/

# Script tạo bài thử dùng một lần, không thuộc sản phẩm.
/tmp-make-lesson.mjs
/run-*.log

# Thu muc cong cua editor; khong phai san pham.
.serena/
