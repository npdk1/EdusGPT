# =============================================================================
# EdusGPT â€” environment variables
# Copy to .env, or simply open http://localhost:3000/setup and paste the
# key there (the setup page writes .env for you and reloads the server).
# =============================================================================

# --- Provider -------------------------------------------------------------
# Which backend the app talks to: gemini | openrouter | antigravity
AI_PROVIDER=groq

# --- Google Gemini (free tier is 20 requests/day) ---------------------------
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- OpenRouter (fallback when the Gemini quota is spent) ------------------
# Get a key at https://openrouter.ai/keys
# Models ending in ":free" cost nothing, e.g. google/gemini-2.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Antigravity CLI (agent cháº¡y ngáº§m trÃªn mÃ¡y, khÃ´ng cáº§n API key) ---------
# CÃ i:      powershell -ExecutionPolicy Bypass -File scripts/install-antigravity.ps1
